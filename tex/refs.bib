	keywords = {galaxies: high-redshift, intergalactic medium, cosmology: observations, Astrophysics - Cosmology and Nongalactic Astrophysics},
	month = aug,
	number = {2},
	pages = {1805-1820},
	primaryclass = {astro-ph.CO},
	title = {{An updated analytic model for attenuation by the intergalactic medium}},
