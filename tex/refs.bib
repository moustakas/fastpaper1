	journal = {\araa},
	keywords = {Astrophysics},
	month = sep,
	number = {1},
	pages = {141-192},
	primaryclass = {astro-ph},
	title = {{Stellar Population Diagnostics of Elliptical Galaxy Formation}},
	volume = {44},
	year = 2006,
	bdsk-file-1 = {},
	bdsk-url-1 = {https://doi.org/10.1146/annurev.astro.44.051905.092450},
