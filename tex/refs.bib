	eid = {139},
	eprint = {1801.10185},
	journal = {\apj},
	keywords = {globular clusters: general, stars: general, Astrophysics - Astrophysics of Galaxies},
	month = feb,
	number = {2},
	pages = {139},
	primaryclass = {astro-ph.GA},
	title = {{Metal-rich, Metal-poor: Updated Stellar Population Models for Old Stellar Systems}},
	volume = {854},
