	title = {{The SAURON project - V. Integral-field emission-line kinematics of 48 elliptical and lenticular galaxies}},
	volume = {366},
	year = 2006,
	bdsk-file-1 = {},
	bdsk-url-1 = {https://doi.org/10.1111/j.1365-2966.2005.09839.x},
