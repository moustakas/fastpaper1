@article{zhu09a,
	abstract = {We measure the evolution of the [O II] lambda3727 luminosity function (LF) at 0.75 < z < 1.45 using high-resolution spectroscopy of ~14,000 galaxies observed by the Deep Extragalactic Evolutionary Probe 2 galaxy redshift survey. We find that brighter than L_[O II]=10^{42} erg s^{-1} the LF is well represented by a power law dN/dL vprop L alpha with slope alpha ~ -3. The number density of [O II]-emitting galaxies above this luminosity declines by a factor of gsim2.5 between z ~ 1.35 and z ~ 0.84. In the limit of no number-density evolution, the characteristic [O II] luminosity, L_[O II]^{*}, defined as the luminosity where the space density equals 10-3.5 dex-1 Mpc-3, declines by a factor of ~1.8 over the same redshift interval. Assuming that L_[O II] is proportional to the star formation rate (SFR), and negligible change in the typical dust attenuation in galaxies at fixed [O II] luminosity, the measured decline in L_[O II]{*} implies a ~25% per Gyr decrease in the amount of star ormation in galaxies during this epoch. Adopting a faint-end power-law slope of -1.3 $\pm$ 0.2, we derive the comoving SFR density in four redshift bins centered around z ~ 1 by integrating the observed [O II] LF using a local, empirical calibration between L_[O II] and SFR, which statistically accounts for variations in dust attenuation and metallicity among galaxies. We find that our estimate of the SFR density at z ~ 1 is consistent with previous measurements based on a variety of independent SFR indicators.},
	adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	adsurl = {http://adsabs.harvard.edu/abs/2009ApJ...701...86Z},
	archiveprefix = {arXiv},
	arxivurl = {http://arXiv.org/abs/0811.3035},
	author = {{Zhu}, G. and {Moustakas}, J. and {Blanton}, M.~R.},
	date-added = {2013-07-15 01:40:30 +0000},
	date-modified = {2013-07-15 01:40:31 +0000},
	eprint = {0811.3035},
	journal = {\apj},
	keywords = {galaxies: evolution, galaxies: luminosity function, mass function, stars: formation},
	month = aug,
	pages = {86-93},
	title = {{The [O II] {$\lambda$}3727 Luminosity Function at z \~{} 1}},
	volume = 701,
	year = 2009,
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1088/0004-637X/701/1/86},
	bdsk-url-2 = {http://arXiv.org/abs/0811.3035},
	bdsk-url-3 = {http://adsabs.harvard.edu/abs/2009ApJ...701...86Z}}

