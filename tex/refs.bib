	eprint = {astro-ph/0511307},
	journal = {\mnras},
	keywords = {galaxies: elliptical and lenticular, cD, galaxies: evolution, galaxies: formation, galaxies: ISM, galaxies: kinematics and dynamics, galaxies: structure, Astrophysics},
	month = mar,
	number = {4},
